{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@components/*": ["./components/*"],
      "@styles/*": ["./styles/*"],
      "@utils/*": ["./utils/*"],
      "@hooks/*": ["./hooks/*"],
      "@pages/*": ["./pages/*"],
      "@lib/*": ["./lib/*"]
    },
    "jsx": "react",
    "checkJs": true,
    "resolveJsonModule": true
  },
  "exclude": ["node_modules", ".next", "out"]
}
